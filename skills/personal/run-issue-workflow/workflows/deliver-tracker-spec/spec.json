{
  "schemaVersion": 1,
  "name": "deliver-tracker-spec",
  "description": "Deliver one Tracker Spec DAG Run by materializing only the actions the Domain action reducer returns.",
  "defaults": {
    "agent": "worker",
    "readOnly": false,
    "tools": [
      "read",
      "grep",
      "find",
      "ls",
      "bash",
      "edit",
      "write"
    ],
    "worktreePolicy": "on"
  },
  "artifactGraph": {
    "stages": [
      {
        "id": "delivery",
        "type": "dynamic",
        "dynamic": {
          "uses": "./helpers/controller.mjs",
          "mode": "graph-splice",
          "permissions": {
            "approval": "auto"
          },
          "budget": {
            "maxConcurrency": 3
          }
        },
        "output": {
          "analysis": {
            "required": true
          },
          "refs": {
            "required": true
          }
        }
      }
    ]
  }
}
